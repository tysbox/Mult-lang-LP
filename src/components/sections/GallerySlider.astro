---
import type { GallerySectionContent } from '../../types';
import GalleryCard from '../ui/GalleryCard.astro';

interface Props extends GallerySectionContent {}

const { id, title, description, items, dividerPattern } = Astro.props;

// Reverted to simple text interpolation (no html conversion)
---

<section id={id} class="space-y-12 py-10">
  <div class="text-center">
    <h3 class="text-2xl md:text-3xl font-bold tracking-tight">{title}</h3>
    <p class="text-subtle-light dark:text-subtle-dark max-w-xl mx-auto mt-2 whitespace-pre-line">{description}</p>
  </div>

  <!-- Slider Container -->
  <div class="slider-container flex gap-[30px] overflow-x-auto pb-6 -mx-6 px-6 sm:-mx-10 sm:px-10 lg:-mx-8 lg:px-8 snap-x snap-mandatory">
    {items.map((item) => (
      <GalleryCard {...item} />
    ))}
  </div>

  <!-- Decorative Divider -->
  {dividerPattern && (
    <div 
      class="h-8 w-full bg-center mt-12 opacity-80"
      style={`
        background-image: ${dividerPattern};
        background-repeat: repeat-x;
        background-size: ${id === 'craftsmanship' ? '64px' : '32px'};
      `}
    />
  )}
</section>
