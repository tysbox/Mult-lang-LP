---
import type { FAQItem } from '../../types';
import FAQItemComponent from '../ui/FAQItem.astro';

interface Props {
  title: string;
  description: string;
  items: FAQItem[];
}

const { title, description, items } = Astro.props;

// Reverted to simple text interpolation (no html conversion)
---

<section id="faq" class="py-20">
  <div class="text-center mb-12">
    <h3 class="text-2xl md:text-3xl font-bold tracking-tight">{title}</h3>
    <p class="text-subtle-light dark:text-subtle-dark max-w-xl mx-auto mt-2 whitespace-pre-line">{description}</p>
  </div>
  
  <div class="max-w-2xl mx-auto space-y-0">
    {items.map((item) => (
      <FAQItemComponent {...item} />
    ))}
  </div>
</section>
