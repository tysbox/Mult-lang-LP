---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section id="contact" class="py-20">
  <div class="text-center mb-12">
    <h3 class="text-2xl md:text-3xl font-bold tracking-tight">{title}</h3>
    <p class="text-subtle-light dark:text-subtle-dark max-w-xl mx-auto mt-2">{description}</p>
  </div>
  
  <form 
    id="contact-form"
    class="mt-12 max-w-xl mx-auto space-y-6"
  >
    <div>
      <label for="name" class="block text-sm font-medium text-subtle-light dark:text-subtle-dark">
        Name
      </label>
      <input 
        type="text" 
        id="name"
        name="name"
        required
        class="mt-1 block w-full rounded-md border border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/50 shadow-sm focus:border-highlight focus:ring-highlight py-2 px-3" 
      />
    </div>
    
    <div>
      <label for="email" class="block text-sm font-medium text-subtle-light dark:text-subtle-dark">
        Email
      </label>
      <input 
        type="email" 
        id="email"
        name="email"
        required
        class="mt-1 block w-full rounded-md border border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/50 shadow-sm focus:border-highlight focus:ring-highlight py-2 px-3" 
      />
    </div>
    
    <div>
      <label for="message" class="block text-sm font-medium text-subtle-light dark:text-subtle-dark">
        Message
      </label>
      <textarea 
        id="message"
        name="message"
        rows={4}
        required
        class="mt-1 block w-full rounded-md border border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/50 shadow-sm focus:border-highlight focus:ring-highlight py-2 px-3"
      ></textarea>
    </div>
    
    <div>
      <button 
        type="submit" 
        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-bold text-background-light dark:text-text-light bg-highlight hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-highlight transition-opacity"
      >
        Send Message
      </button>
    </div>
  </form>

  <div 
    id="form-message" 
    class="mt-4 text-center text-base hidden"
  ></div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const messageDiv = document.getElementById('form-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // ここでフォームデータを処理
    // 例: APIエンドポイントに送信
    try {
      // await fetch('/api/contact', {
      //   method: 'POST',
      //   headers: { 'Content-Type': 'application/json' },
      //   body: JSON.stringify(data)
      // });

      // 成功メッセージ
      if (messageDiv) {
        messageDiv.textContent = `Thank you for your message.
Your submission has been sent successfully.
Our native Japanese representative will carefully review your comments.
If a reply is required, we will get back to you personally within approximately one week.
Thank you for your patience.`;
        messageDiv.className = 'mt-4 text-center text-base whitespace-pre-line text-green-600 dark:text-green-400';
        messageDiv.classList.remove('hidden');
      }
      form.reset();

    } catch (error) {
      // エラーメッセージ
      if (messageDiv) {
        messageDiv.textContent = 'Sorry, there was an error sending your message. Please try again.';
        messageDiv.className = 'mt-4 text-center text-base text-red-600 dark:text-red-400';
        messageDiv.classList.remove('hidden');
      }
    }

    // メッセージを3秒後に非表示
    setTimeout(() => {
      messageDiv?.classList.add('hidden');
    }, 3000);
  });
</script>