---
import fs from 'fs';
import path from 'path';

const contentPath = path.join(process.cwd(), 'content/pages');
const globalPath = path.join(process.cwd(), 'content/global');

// 編集対象の言語（en がデフォルト、他は home.<lang>.json / settings.<lang>.json）
const LOCALES = [
  { code: 'en', label: 'English', flag: '🇬🇧' },
  { code: 'ja', label: '日本語', flag: '🇯🇵' },
  { code: 'zh', label: '中文', flag: '🇨🇳' },
  { code: 'ko', label: '한국어', flag: '🇰🇷' },
  { code: 'fr', label: 'Français', flag: '🇫🇷' },
];

function readJson(filePath: string, fallback: any) {
  try {
    if (fs.existsSync(filePath)) return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  } catch (e) {
    console.warn('[admin] failed to read', filePath, e);
  }
  return fallback;
}

// ページデータの安全なデフォルトを適用
function withPageDefaults(pageData: any) {
  if (!pageData.hero) pageData.hero = { title: '', subtitle: '', ctaText: '', bgImage: '', alt: '' };
  if (!pageData.founder) pageData.founder = { id: 'founder', preheading: '', title: '', description: '', image: '', imageAlt: '', isSplit: false };
  if (!pageData.journeys) pageData.journeys = { id: 'journeys', preheading: '', title: '', description: '' };
  if (!pageData.intro) pageData.intro = { id: 'intro', preheading: '', title: '', description: '' };
  if (!Array.isArray(pageData.galleries)) pageData.galleries = [];
  if (!pageData.faq) pageData.faq = { title: '', description: '', items: [] };
  if (!Array.isArray(pageData.faq.items)) pageData.faq.items = [];
  if (!pageData.contact) pageData.contact = { title: '', description: '' };
  return pageData;
}

// グローバル設定の安全なデフォルトを適用
function withSettingsDefaults(globalSettings: any) {
  if (!globalSettings.header) globalSettings.header = { logo: { image: '', text: '' }, menuItems: [] };
  if (!Array.isArray(globalSettings.header.menuItems)) globalSettings.header.menuItems = [];
  if (!globalSettings.footer) globalSettings.footer = { copyright: '', description: '', socialLinks: [], footerLinks: [] };
  if (!Array.isArray(globalSettings.footer.socialLinks)) globalSettings.footer.socialLinks = [];
  if (!Array.isArray(globalSettings.footer.footerLinks)) globalSettings.footer.footerLinks = [];
  return globalSettings;
}

// en を基準（フォールバック元）として読み込む
const enPage = withPageDefaults(readJson(path.join(contentPath, 'home.json'), {}));
const enSettings = withSettingsDefaults(readJson(path.join(globalPath, 'settings.json'), {}));

// 全言語分のコンテンツを読み込み（無ければ en にフォールバック）
const localeData: Record<string, { page: any; settings: any }> = {};
for (const { code } of LOCALES) {
  const suffix = code === 'en' ? '' : `.${code}`;
  const page = readJson(path.join(contentPath, `home${suffix}.json`), enPage);
  const settings = readJson(path.join(globalPath, `settings${suffix}.json`), enSettings);
  localeData[code] = {
    page: withPageDefaults(page),
    settings: withSettingsDefaults(settings),
  };
}
