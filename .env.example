# TinaCMS設定
TINA_CLIENT_ID=your_client_id_here
TINA_TOKEN=your_token_here
TINA_BRANCH=master

# 開発時は公開トークンでOK
TINA_PUBLIC_IS_LOCAL=true

# GitHub API settings (for save/load via GitHub Contents API)
# Set these in Cloudflare environment when deploying.
GITHUB_TOKEN=your_github_token_with_repo_scope
GITHUB_REPOSITORY=owner/repo
GITHUB_BRANCH=master

# Web3Forms (client-side fetch submissions)
# PUBLIC_* are safe to be public and are used by the client. Set these in Cloudflare Pages environment for production.
PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Cloudflare Web Analytics (client-side beacon token). Set this in production environment only.
PUBLIC_CLOUDFLARE_BEACON_TOKEN=your_cloudflare_beacon_token_here

# Server-side settings (set these in Cloudflare Pages environment; do NOT commit secrets)
TURNSTILE_SECRET_KEY=your_turnstile_secret_here
